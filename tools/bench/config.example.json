{
  "rkvc": "../../.build/release/rkvc",
  "warmup": 1,
  "iterations": 5,
  "timeout_seconds": 600,
  "cooldown_seconds": 1,
  "cases": [
    {
      "name": "decode-h264-1080p",
      "operation": "decode",
      "input": "media/sample-1080p.h264",
      "codec": "h264",
      "width": 1920,
      "height": 1080,
      "frames": 300,
      "duration_seconds": 10,
      "thresholds": {
        "min_fps": 60,
        "min_realtime": 2
      }
    },
    {
      "name": "encode-h264-1080p",
      "operation": "encode",
      "input": "media/sample-1080p.nv12",
      "output": "output.h264",
      "codec": "h264",
      "width": 1920,
      "height": 1080,
      "bitrate_bps": 4000000,
      "duration_seconds": 10
    },
    {
      "name": "transcode-hevc-to-h264",
      "operation": "transcode",
      "input": "media/sample-1080p.h265",
      "output": "output.h264",
      "codec": "h264",
      "frames": 300,
      "duration_seconds": 10
    }
  ]
}


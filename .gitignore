# Build trees (see docs/build-layout.md / CMakePresets.json)
# Canonical: .build/{release,debug,tests,asan,coverage,portable,dist,deps}/
# Legacy root-level build/ / build-*/ kept ignored so leftovers never enter git.
.build/
build/
build-*/
build_*/
*.o
*.a
*.so
*.so.*
*.dylib

# CMake / CTest / CPack
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
Makefile
compile_commands.json
Testing/
packages/
*.deb

# ffmpeg 子模块就地构建产物（prefix=源码树时）
third_party/ffmpeg-rockchip/ffbuild/
third_party/ffmpeg-rockchip/config.h
third_party/ffmpeg-rockchip/config_components.h
third_party/ffmpeg-rockchip/*.pc
third_party/ffmpeg-rockchip/ffversion.h
third_party/ffmpeg-rockchip/ffmpeg
third_party/ffmpeg-rockchip/ffprobe
third_party/ffmpeg-rockchip/ffplay

# Coverage / Sanitizer
*.gcno
*.gcda
*.gcov
coverage/

# Test & Bench results（bench/ 内 work/、results/ 见 bench/.gitignore）
results/
bench_results/
*.bak
*.pre_*

# RKNN 超分模型（本地放置，不入库）
*.rknn

# Docs
site/

# IDE
.vscode/
.idea/
*.swp
*~

# Python
__pycache__/
*.pyc
.venv/

# Misc
.cache/
.scratch/
nohup.out
*.xml
*.log

# Test media files
*.mp4
*.mkv
*.webm
*.h264
*.h265
*.ivf
*.yuv
*.y4m
*.nv12

# Office 文档（产品说明等，不入库）
*.docx

# 授权私钥 & license 文件（1机1码）- 切勿提交
*.pem
*.lic
tools/keys/*secret*
tools/keys/*.pem
# genkey 产出的中间文件（CMake 从 public.key 自动生成 license_pubkey.c，无需此头文件）
tools/keys/public_key.h

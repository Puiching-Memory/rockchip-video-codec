# Build trees (see docs/build-layout.md / CMakePresets.json)
# Canonical: .build/{release,debug,tests,asan,coverage,portable,dist,deps}/
# Legacy root-level build/ / build-*/ kept ignored so leftovers never enter git.
.build/
# 0.3 MLVC 参考源码（只读对照用，不入库）
.mlvc-ref/
build/
build-*/
build_*/
*.o
*.a
*.so
*.so.*
*.dylib

# CMake / CTest / CPack
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
Makefile
compile_commands.json
Testing/
packages/
*.deb

# ffmpeg 子模块就地构建产物（prefix=源码树时）
third_party/ffmpeg-rockchip/ffbuild/
third_party/ffmpeg-rockchip/config.h
third_party/ffmpeg-rockchip/config_components.h
third_party/ffmpeg-rockchip/*.pc
third_party/ffmpeg-rockchip/ffversion.h
third_party/ffmpeg-rockchip/ffmpeg
third_party/ffmpeg-rockchip/ffprobe
third_party/ffmpeg-rockchip/ffplay

# Coverage / Sanitizer
*.gcno
*.gcda
*.gcov
coverage/

# Test & Bench results（tools/bench/ 内 work/、results/ 见 tools/bench/.gitignore）
results/
bench_results/
*.bak
*.pre_*

# RKNN 超分模型 / MLVC PMF 表（本地放置，不入库）
*.rknn
*.qppatch
/models/rkvc-sr/
/models/**/*.bin
/models/**/mlvc_rknn_export_manifest.json
/models/**/*_qp_models/
/models/**/qp_patches/

# Docs
site/

# IDE
.vscode/
.idea/
*.swp
*~

# Python
__pycache__/
*.pyc
.venv/

# Misc
.cache/
.scratch/
nohup.out
*.xml
*.log

# Test media files
*.mp4
*.mkv
*.webm
*.h264
*.h265
*.ivf
*.yuv
*.mlvc
*.y4m
*.nv12

# Office 文档（产品说明等，不入库）
*.docx
